# — Copy to .env for local dev (SQLite, already working) —
DATABASE_URL=file:/home/z/my-project/db/custom.db

# — Production (Vercel + hosted Postgres, e.g. Vercel Postgres / Neon / Supabase) —
# Set BOTH in Vercel → Project → Settings → Environment Variables:
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# NEXT_PUBLIC_SITE_URL=https://www.threethai.com
#   ↑ canonical host MUST match the serving host (www) — apex 308-redirects to www

# — Search engine ownership verification (optional; meta tags render only when set) —
# Value = the content="..." token each console gives you (no quotes)
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
# YANDEX_SITE_VERIFICATION=

# — Inquiry email notifications (Tencent Exmail SMTP) —
# SMTP_USER=salesmanager@threethai.com
# SMTP_PASS=<client-specific password>
