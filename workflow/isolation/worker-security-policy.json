{
  "schema_version": "1.0.0",
  "architecture": "WIN-OCI-CELL-01",
  "activation": "DISABLED",
  "machine_enforcement": "PENDING_MACHINE_AUTHORIZATION",
  "controller": {
    "service_identity": "NT SERVICE\\ThreeThaiCodexController",
    "non_admin": true,
    "signer_reference": "cng://LocalMachine/ThreeThaiCodexController",
    "secret_store_reference": "windows-credential-manager://ThreeThaiCodexController",
    "worker_receives_signer": false,
    "worker_receives_secret_store": false
  },
  "wsl": {
    "distribution": "ThreeThai-Codex-Worker",
    "dedicated": true,
    "automount_enabled": false,
    "interop_enabled": false,
    "append_windows_path": false,
    "workspace_root": "/var/lib/threethai-cells",
    "windows_drive_mounts_forbidden": true
  },
  "codex": {
    "package": "@openai/codex",
    "cli_version": "0.153.0-alpha.5",
    "provider_id": "openai",
    "provider": "OpenAI",
    "model": "gpt-5.6-sol",
    "reasoning_effort": "high",
    "approval_policy": "never",
    "web_search": "disabled",
    "automatic_fallback": false,
    "worker_cwd": "/workspace",
    "codex_home": "/run/codex-home",
    "profiles": {
      "implementation": "workspace-write",
      "review": "read-only"
    },
    "disabled_capabilities": [
      "apps",
      "browser_use",
      "computer_use",
      "in_app_browser",
      "mcp",
      "multi_agent",
      "plugins",
      "remote_control",
      "remote_plugins",
      "skills",
      "web_search"
    ]
  },
  "environment": {
    "inherit": "none",
    "allowlist": [
      "CODEX_HOME",
      "HOME",
      "LANG",
      "LC_ALL",
      "PATH",
      "TMPDIR",
      "THREETHAI_GATEWAY_LEASE_PATH",
      "THREETHAI_GATEWAY_SOCKET",
      "THREETHAI_RUN_ID",
      "THREETHAI_TASK_KEY"
    ],
    "forbidden": [
      "OPENAI_API_KEY",
      "GITHUB_TOKEN",
      "GH_TOKEN",
      "SSH_AUTH_SOCK",
      "GPG_AGENT_INFO",
      "AWS_ACCESS_KEY_ID",
      "AWS_SECRET_ACCESS_KEY",
      "AZURE_CLIENT_SECRET",
      "GOOGLE_APPLICATION_CREDENTIALS"
    ]
  },
  "oci": {
    "runtime": "podman",
    "image_build_context": "workflow/isolation/oci",
    "runtime_image_ref": "PENDING_MACHINE_AUTHORIZATION",
    "digest_required": true,
    "uid": 65532,
    "gid": 65532,
    "read_only_root_filesystem": true,
    "capabilities_drop": ["ALL"],
    "no_new_privileges": true,
    "network": "none",
    "pid_namespace": "private",
    "ipc_namespace": "private",
    "uts_namespace": "private",
    "user_namespace": "auto:size=65536",
    "cgroup_namespace": "private",
    "seccomp_profile": "workflow/isolation/oci/seccomp.json",
    "pids_limit": 256,
    "memory_bytes": 2147483648,
    "cpu_quota": 100000,
    "cpu_period": 100000,
    "ephemeral": true,
    "runtime_socket_exposed": false,
    "host_namespace_sharing": false
  },
  "projection": {
    "source_mount_allowed": false,
    "git_metadata_included": false,
    "review_read_only": true,
    "exclude_names": [
      ".codex",
      ".env",
      ".git",
      ".git-credentials",
      ".gitconfig",
      ".gitmodules",
      ".gnupg",
      ".netrc",
      ".npmrc",
      ".pypirc",
      ".ssh",
      ".yarnrc",
      ".yarnrc.yml",
      ".aws",
      ".azure",
      ".docker",
      ".kube",
      ".terraform",
      ".terraformrc",
      "auth.json",
      "credentials.json",
      "credentials.toml",
      "gradle.properties",
      "id_ed25519",
      "id_rsa",
      "nuget.config",
      "pip.conf",
      "service-account.json",
      "settings.xml"
    ],
    "exclude_prefixes": [
      ".threethai-controller/",
      "controller-state/"
    ],
    "exclude_suffixes": [
      ".key",
      ".kdbx",
      ".p12",
      ".pem",
      ".pfx"
    ],
    "max_file_bytes": 2000000,
    "max_bundle_bytes": 25000000
  },
  "gateway": {
    "transport": "controller-owned-unix-socket",
    "socket_path": "/run/inference-gateway/gateway.sock",
    "lease_path": "/run/inference-gateway/lease.json",
    "provider_destination": "https://api.openai.com/v1/responses",
    "allowed_operations": ["responses.create"],
    "connect_tunneling": false,
    "arbitrary_urls": false,
    "private_destinations": false,
    "max_requests": 64,
    "max_input_tokens": 400000,
    "max_output_tokens": 64000,
    "max_duration_seconds": 3600
  }
}
